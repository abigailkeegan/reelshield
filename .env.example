# Copy this file to .env and fill in your real API keys.
# NEVER commit .env to GitHub — it is listed in .gitignore.

# ─── Required ──────────────────────────────────────────────────
TMDB_API_KEY=your_tmdb_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Optional ──────────────────────────────────────────────────
# OMDb enriches the "External Reviews" section with IMDb / Rotten
# Tomatoes / Metacritic scores. The app still works without it;
# that section will just be empty.
OMDB_API_KEY=

# Flask session signing key. If unset, a random key is generated
# on every container restart, which invalidates existing user
# sessions. Set this to a stable random value in production.
SECRET_KEY=

# SQLite file path inside the container. Defaults to /data/movie_cache.db.
DB_PATH=

# Base URL the seed_movies.py helper hits to populate the cache.
# Defaults to http://localhost:7860 — only override for non-default ports.
REELSHIELD_BASE=
